# ==========================================
# FAST CART ENVIRONMENT CONFIGURATION
# ==========================================
#
# Secrets have NO fallback values. A missing or too-short signing secret makes
# the app refuse to authenticate anyone rather than silently signing tokens
# with a value committed to the repository.
#
# Generate each secret with:
#   openssl rand -base64 48

# ------------------------------------------
# Application
# ------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Number of reverse proxies in front of the app (nginx, Vercel, Cloudflare = 1).
# The rate limiter reads the client IP this many hops from the right-hand end
# of x-forwarded-for; everything further left is client-controlled.
TRUSTED_PROXY_HOPS=1

# ------------------------------------------
# Signing secrets  (REQUIRED — min 32 characters each)
# ------------------------------------------
# Admin console sessions.
ADMIN_JWT_SECRET=

# B2B trade portal sessions. Keep distinct from ADMIN_JWT_SECRET so a
# compromise of one audience does not hand over the other.
TRADE_JWT_SECRET=

# Customer (storefront) sessions.
CUSTOMER_SESSION_SECRET=

# ------------------------------------------
# Admin credentials
# ------------------------------------------
# Primary admin auth is WordPress (administrator / shop_manager role) via the
# WooCommerce store URL below.
#
# These two are a DEVELOPMENT-ONLY fallback and are ignored entirely when
# NODE_ENV=production. Leave them unset in any deployed environment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password-in-development-only

# ------------------------------------------
# WooCommerce
# ------------------------------------------
# Credentials are sent as an Authorization: Basic header, never as query
# parameters — query parameters end up in access logs and proxy traces.
WOOCOMMERCE_STORE_URL=https://your-woocommerce-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HMAC-SHA256 (base64) signing secret for WooCommerce webhooks.
# Read only from here — it is no longer stored in data/store.json.
WOOCOMMERCE_WEBHOOK_SECRET=

# ------------------------------------------
# Paystack
# ------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HMAC-SHA512 (hex) signing secret for Paystack webhooks. Without it the
# webhook refuses every request, and orders never move to "processing".
PAYSTACK_WEBHOOK_SECRET=

# ------------------------------------------
# Email delivery (OTP codes, trade documents)
# ------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Happy Hour"

# ------------------------------------------
# Shared state  (REQUIRED for multi-instance / serverless)
# ------------------------------------------
# OTP challenges and rate-limit counters fall back to an in-process Map when
# these are unset. That is correct for a single long-lived server only: across
# instances, rate limits divide by the instance count and a pending OTP is
# invisible to whichever instance handles the verify request.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------
# Scheduled jobs
# ------------------------------------------
# Shared secret for /api/cron/reconcile, which re-pulls anything the
# WooCommerce webhooks missed. Unset means the endpoint refuses every
# request — it is never open by default.
#   */2 * * * * curl -sS -H "x-cron-secret: $CRON_SECRET" https://site/api/cron/reconcile
CRON_SECRET=
